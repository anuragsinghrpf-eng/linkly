NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/verdant.sqlite
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-different-32-byte-random-secret
SESSION_TTL_HOURS=168
UNLOCK_TTL_MINUTES=60
MINIMUM_WITHDRAWAL_MINOR_UNITS=200
DEFAULT_CURRENCY=USD
# Set this only when an ad provider supports signed server callbacks.
# HMAC-SHA256 of the exact request body is expected in X-Provider-Signature.
AD_CALLBACK_SECRET=
EMAIL_FROM=links@example.com
# Implicit TLS SMTP is supported (port 465): smtps://username:password@smtp.example.com:465
SMTP_URL=
